{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-chat",
  "small_model": "deepseek/deepseek-chat",
  "autoupdate": false,
  "provider": {
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "interleaved": {
            "field": "reasoning_content"
          }
        }
      }
    }
  },
  "mcp": {
    "grafana-read": {
      "type": "remote",
      "url": "http://grafana-mcp-gateway:8080/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GRAFANA_MCP_TOKEN}"
      },
      "enabled": true,
      "timeout": 10000
    },
    "playbooks": {
      "type": "remote",
      "url": "http://control-plane:8080/mcp/playbooks",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:PLAYBOOK_MCP_TOKEN}"
      },
      "enabled": true,
      "timeout": 10000
    },
    "canvas": {
      "type": "remote",
      "url": "http://control-plane:8080/mcp/canvas",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CANVAS_MCP_TOKEN}"
      },
      "enabled": true,
      "timeout": 10000
    }
  },
  "tools": {
    "write": false,
    "edit": false,
    "bash": false
  }
}
